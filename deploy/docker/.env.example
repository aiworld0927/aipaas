# =============================================================================
# AIPaaS 部署环境变量模板
# -----------------------------------------------------------------------------
# 使用：cp .env.example .env && vim .env
#
# 优先级（高 → 低）：
#   1. shell 已导出变量（如 source ../scripts/setup-env.sh devhome）
#   2. 本 .env 文件
#   3. docker-compose.yaml 中的内置默认值
#
# 部分变量 setup-env.sh 已导出（POSTGRES_*、REDIS_*、NACOS_*、MINIO_*、
# LLM_*、DOCKER_VOLUME_DIRECTORY、HOST_UID/HOST_GID 等），source 后会覆盖本文件。
# =============================================================================

# ---------- Docker 数据卷 & 日志目录 ----------
# 中间件数据目录（base 编排按 ${DOCKER_VOLUME_DIRECTORY}/volumes 拼接），默认值参考 setup-env.sh
DOCKER_VOLUME_DIRECTORY=/home/aipaas/docker_hub
# 应用日志目录（svc-ingest / svc-query 日志统一归档到 ./logs/<service>/）
DOCKER_LOG_DIRECTORY=.
# 容器进程 uid/gid（setup-env.sh 会自动导出为当前用户，此处为兜底默认值）
HOST_UID=1000
HOST_GID=1000

# ---------- 可选技术组件开关（Compose profiles）----------
# 核心组件（etcd/minio/milvus/mongodb/postgres/redis）默认启动；
# 以下可选组件按 profile 加载，逗号分隔，可任意组合：
#   attu      —— Milvus 可视化管理 UI（:3000）
#   nacos     —— Nacos 配置中心（:8848，复用核心 postgres）
#   rocketmq  —— namesrv + broker 消息队列（:9876/:10911）
#   vllm      —— vLLM 本地推理 Qwen3-0.6B（:8008，需 NVIDIA GPU）
# 默认仅启用轻量级 attu；留空 = 可选组件全部不启动；组合示例：COMPOSE_PROFILES=nacos,attu
COMPOSE_PROFILES=attu

# =============================================================================
# 中间件（默认值参考 setup-env.sh）
# =============================================================================

# --- MinIO 对象存储（与 setup-env.sh 命名一致；Python 服务复用这两个密钥）---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- MongoDB 文档存储（docker-compose-base.yaml 中账密固定为 admin/123456）---
MONGO_URL=mongodb://admin:123456@mongodb:27017/?authSource=admin
MONGO_PORT=27017

# --- PostgreSQL（Nacos 与 Java 平台共用实例，各自使用独立数据库）---
POSTGRES_USER=nacos
POSTGRES_PASSWORD=nacos
POSTGRES_DB=nacos
POSTGRES_PORT=5432

# --- Redis 缓存（核心组件，setup-env.sh 默认无密码）---
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Nacos 配置中心（与 setup-env.sh 一致）---
NACOS_PORT=8848
NACOS_PORT_GRPC=9848
NACOS_AUTH_ENABLE=true
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=mySecureValue123
# 生产务必替换为 32 位以上随机字符串
NACOS_AUTH_TOKEN=VGhpc0lzTXlTZWNyZXRLZXlXaGljaFNob3VsZEJlMzJDaGFyYWN0ZXJzTGFyZ2U=

# --- RocketMQ 消息队列 ---
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_PORT2=10909
ROCKETMQ_NAMESRV_JAVA_OPT=-Xms128m -Xmx256m -Xmn64m
ROCKETMQ_BROKER_JAVA_OPT=-Xms256m -Xmx512m -Xmn128m

# =============================================================================
# Python AI 服务
# -----------------------------------------------------------------------------
# 业务配置（模型、阈值、连接地址、后端开关等）已迁移至配置包：
#   pymodules/configs/aipaas_config.base.yaml + aipaas_config.{APP_ENV}.yaml
#   容器内挂载为 /app/configs（CONFIG_PACKAGE_DIR 指定宿主机目录）
# 此处仅保留：环境标识、端口/卷编排变量、密钥
# =============================================================================

# --- 配置包（APP_ENV 可选值：devhome / devcompany）---
APP_ENV=devcompany
# 容器内配置目录（与 compose 中挂载点一致，一般无需修改）
CONFIG_DIR=/app/configs
# 宿主机配置包目录（默认工程内 ../../pymodules/configs；部署交付时改为外部制品目录）
#CONFIG_PACKAGE_DIR=../../pymodules/configs

# =============================================================================
# 镜像版本标签
# =============================================================================
# 控制 compose 使用的镜像 tag：latest = 开发用；发布时改成版本号（如 0.1.0、20261112）
# 用法：IMAGE_TAG=0.1.0 docker-compose build && IMAGE_TAG=0.1.0 docker-compose up -d
IMAGE_TAG=latest

# 共享 torch 基础镜像 tag（torch 版本升级时递增，与 aipaas/aipaas-torch-{cpu,gpu}-base 对应）
PY_GPU_TAG=local
PY_CPU_TAG=local
# compose 实际使用的 tag（与 TORCH_VARIANT 配套；两变体 tag 相同时保持一致即可）
PY_BASE_TAG=local

# --- 各 worker 监听端口（统一命名：{模块名大写}_PORT，改这里即可同时调整
#     容器内监听端口、宿主机映射端口与服务间调用地址）---
# svc-ingest（文档导入）
INGEST_WORKER_PORT=8001
# svc-query（用户查询）
QUERY_WORKER_PORT=8002
# svc-model-embedding（嵌入）
MODEL_EMBEDDING_WORKER_PORT=8003
# svc-model-reranker（重排序）
MODEL_RERANKER_WORKER_PORT=8004
# rag-ai-api（统一契约骨架，容器内固定监听 8100）
RAG_AI_API_PORT=8100
# 宿主机模型根目录（其下需有 bge-m3 / bge-reranker-large 两个目录）
MODEL_BASE_DIR=/coding/models/BAAI
# 模型服务镜像的 torch 构建：cpu=纯 CPU；gpu=CUDA 12.8
# 环境默认值由 setup-env.sh 提供：devhome=gpu（本模板默认）  devcompany=cpu
TORCH_VARIANT=cpu

# --- 密钥（配置包 YAML 中 ${oc.env:...} 引用的环境变量）---
# 业务侧 LLM / 在线模型密钥（在线后端未单独配置时复用）
OPENAI_API_KEY=
# MinerU 文档解析服务令牌（svc-ingest 使用）
MINERU_API_TOKEN=
# 在线嵌入 / 在线重排序独立密钥（可选，缺省回退 OPENAI_API_KEY）
#EMBEDDING_ONLINE_API_KEY=
#TEXT_RERANK_API_KEY=

# --- vLLM 本地推理（COMPOSE_PROFILES 含 vllm 时生效，需 NVIDIA GPU）---
# 模型目录（ModelScope 下载 Qwen/Qwen3-0.6B 到该路径）
VLLM_MODEL_DIR=../../models/Qwen3-0.6B
VLLM_PORT=8008
VLLM_SERVED_MODEL_NAME=qwen3-0.6b
VLLM_MAX_MODEL_LEN=8192
# 显存占用比例（0~1，多模型同卡时调低）
VLLM_GPU_MEMORY_UTILIZATION=0.85

# =============================================================================
# 第 4 级：Java 网关与管理平台（platform-gateway / platform-management）
# =============================================================================
# 网关是 Java 唯一宿主机入口；管理服务只在 aipaas-network 内 expose 8080。
PLATFORM_GATEWAY_PORT=8081
# Java 平台在共用 PostgreSQL 实例中使用的独立数据库
PLATFORM_DB=aipaas
PLATFORM_MINIO_BUCKET=aipaas
# 首次启动必填：12–128 位，含大小写字母、数字、特殊字符；不得包含 admin 或常见弱口令。
PLATFORM_BOOTSTRAP_ADMIN_PASSWORD=

# =============================================================================
# 前端
# =============================================================================
FRONTEND_PORT=80
FRONTEND_HTTPS_PORT=443

# ---------- P0 安全底座 ----------
# 首次启动必填：12–128 位，含大小写字母、数字、特殊字符；不得包含 admin 或常见弱口令。
P0_BOOTSTRAP_ADMIN_PASSWORD=
# 开发环境可 true 自动生成 30 天自签证书；生产必须挂载正式证书并设为 false。
TLS_GENERATE_SELF_SIGNED=true
TLS_SERVER_NAME=localhost
AIPAAS_AUDIT_RETENTION_DAYS=180

# ---------- P0 可观测（#173/#175/#177） ----------
# 结构化请求日志保留天数（数据库清理 + 文件滚动共用）
AIPAAS_REQUEST_LOG_RETENTION_DAYS=30
# 单实例内存 Span 上限，按 TraceID 查询时使用
AIPAAS_TRACE_MAX_SPANS=20000
# Grafana 管理员密码（首次启动生效，请改为强口令）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=aipaas_grafana_p0
