# =============================================================================
# AIPaaS Python 服务本地开发环境变量模板（cp .env.example .env）
# 仅保留：环境标识 + 配置目录 + 密钥
# 业务配置统一在 configs/aipaas_config.base.yaml + aipaas_config.{APP_ENV}.yaml
# =============================================================================

# 环境标识（可选值：devhome / devcompany/ dev_win10 /dev_win11）
APP_ENV=devcompany
# 配置包目录（相对路径基于启动目录，建议从 pymodules 目录启动；也可改为绝对路径）
CONFIG_DIR=configs

# ---------- 密钥（YAML 中 ${oc.env:...} 引用）----------
OPENAI_API_KEY=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MONGO_URL=mongodb://admin:123456@<中间件主机IP>:27017
MINERU_API_TOKEN=

# 可选：在线模型后端独立密钥（缺省回退 OPENAI_API_KEY）
#EMBEDDING_ONLINE_API_KEY=
#TEXT_RERANK_API_KEY=

# ---------- Nacos 注册中心（可选，缺省值见 configs/aipaas_config.base.yaml）----------
# NACOS_ENABLED=false 时不加载 Nacos 对接包，也不做服务注册
#NACOS_ENABLED=true
#NACOS_SERVER_ADDR=nacos:8848
#NACOS_NAMESPACE=public
#NACOS_USERNAME=
#NACOS_PASSWORD=
# 容器/裸机自动探测 IP 不适用时（如 NAT 环境）手动指定注册 IP
#NACOS_REGISTER_IP=
