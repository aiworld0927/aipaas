# =============================================================================
# AIPaaS 部署环境变量模板
# -----------------------------------------------------------------------------
# 使用：cp .env.example .env && vim .env
#
# 优先级（高 → 低）：
#   1. shell 已导出变量（如 source ../scripts/setup-env.sh devhome）
#   2. 本 .env 文件
#   3. docker-compose.yaml 中的内置默认值
#
# 部分变量 setup-env.sh 已导出（POSTGRES_*、REDIS_*、NACOS_*、MINIO_*、
# LLM_*、DOCKER_VOLUME_DIRECTORY、HOST_UID/HOST_GID 等），source 后会覆盖本文件。
# =============================================================================

# ---------- Docker 数据卷 & 日志目录 ----------
# 中间件数据目录（base 编排按 ${DOCKER_VOLUME_DIRECTORY}/volumes 拼接），默认值参考 setup-env.sh
DOCKER_VOLUME_DIRECTORY=/home/aipaas/docker_hub
# 应用日志目录（svc-ingest / svc-query 日志统一归档到 ./logs/<service>/）
DOCKER_LOG_DIRECTORY=.
# 容器进程 uid/gid（setup-env.sh 会自动导出为当前用户，此处为兜底默认值）
HOST_UID=1000
HOST_GID=1000

# ---------- 日志级别 ----------
LOG_LEVEL=INFO

# =============================================================================
# 中间件（默认值参考 setup-env.sh）
# =============================================================================

# --- MinIO 对象存储（与 setup-env.sh 命名一致）---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=aipaas

# --- MongoDB 文档存储（docker-compose-base.yaml 中账密固定为 admin/123456）---
MONGO_URL=mongodb://admin:123456@mongodb:27017/?authSource=admin
MONGO_DB_NAME=aipaas
MONGO_PORT=27017

# --- PostgreSQL（Nacos 主库，与 setup-env.sh 一致）---
POSTGRES_USER=nacos
POSTGRES_PASSWORD=nacos
POSTGRES_DB=nacos
POSTGRES_PORT=5432

# --- Redis 缓存（setup-env.sh 默认无密码）---
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Milvus 向量数据库（本地 compose 用服务名；连远程中间件时改为 http://<IP>:19530）---
MILVUS_URL=http://milvus:19530

# --- Milvus Collection（按需调整）---
CHUNKS_COLLECTION=chunks

# --- Nacos 配置中心（与 setup-env.sh 一致）---
NACOS_PORT=8848
NACOS_PORT_GRPC=9848
NACOS_AUTH_ENABLE=true
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=mySecureValue123
# 生产务必替换为 32 位以上随机字符串
NACOS_AUTH_TOKEN=VGhpc0lzTXlTZWNyZXRLZXlXaGljaFNob3VsZEJlMzJDaGFyYWN0ZXJzTGFyZ2U=

# --- RocketMQ 消息队列 ---
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_PORT2=10909
ROCKETMQ_NAMESRV_JAVA_OPT=-Xms128m -Xmx256m -Xmn64m
ROCKETMQ_BROKER_JAVA_OPT=-Xms256m -Xmx512m -Xmn128m

# =============================================================================
# Python AI 服务
# =============================================================================
# 说明：setup-env.sh 导出的是 LLM_BASE_URL / LLM_API_KEY / LLM_MODEL_NAME，
# 代码实际读取 OPENAI_BASE_URL / OPENAI_API_KEY / MODEL（compose 中已做映射）。

# --- svc-ingest（文档导入）---
INGEST_PORT=8000

# --- svc-query（用户查询）---
QUERY_PORT=8001

# --- 外部 LLM（容器内访问宿主机模型服务用 host.docker.internal）---
# 本地 compose 默认走容器内解析；连远程模型时改为 http://<IP>:11434/v1
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_NAME=qwen2.5

# =============================================================================
# Java 微服务（javaplat 暂为规划状态，未纳入编排；端口预留，详见 javaplat/TODO说明.md）
# =============================================================================
#GATEWAY_PORT=8085
#AUTH_PORT=8081
#DOCUMENT_PORT=9082
#SEARCH_PORT=8083
#AGENT_PORT=8086

# =============================================================================
# 前端
# =============================================================================
FRONTEND_PORT=80
