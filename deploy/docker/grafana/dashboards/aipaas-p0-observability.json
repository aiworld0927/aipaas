{
  "title": "AIPaaS P0 输出合规与可观测",
  "uid": "aipaas-p0-observability",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "tags": ["aipaas", "p0", "observability"],
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "title": "QPS（按服务）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "aipaas-prom"},
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"fillOpacity": 10}}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum by (service) (rate(aipaas_requests_total[1m]))", "legendFormat": "{{service}}"},
        {"refId": "B", "expr": "sum by (service) (rate(aipaas_http_requests_total[1m]))", "legendFormat": "{{service}}"}
      ]
    },
    {
      "id": 2,
      "title": "成功率（非 5xx）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "aipaas-prom"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum by (service) (rate(aipaas_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum by (service) (rate(aipaas_requests_total[5m])), 0.001))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "延迟 P50 / P95 / P99",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "aipaas-prom"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"refId": "P50", "expr": "histogram_quantile(0.50, sum by (le, service) (rate(aipaas_request_duration_seconds_bucket[5m])))", "legendFormat": "p50 {{service}}"},
        {"refId": "P95", "expr": "histogram_quantile(0.95, sum by (le, service) (rate(aipaas_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{service}}"},
        {"refId": "P99", "expr": "histogram_quantile(0.99, sum by (le, service) (rate(aipaas_request_duration_seconds_bucket[5m])))", "legendFormat": "p99 {{service}}"}
      ]
    },
    {
      "id": 4,
      "title": "链路环节 P95（解析→分块→检索→生成）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "aipaas-prom"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, name) (rate(aipaas_span_duration_seconds_bucket[5m])))",
          "legendFormat": "{{name}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(aipaas_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "http {{service}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "检索命中率 / 拒答率",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "aipaas-prom"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [
        {
          "refId": "HIT",
          "expr": "sum(rate(aipaas_retrieval_hits_total[10m])) / clamp_min(sum(rate(aipaas_retrieval_queries_total[10m])), 0.001)",
          "legendFormat": "检索命中率"
        },
        {
          "refId": "REFUSAL",
          "expr": "sum(rate(aipaas_generation_refusals_total[10m])) / clamp_min(sum(rate(aipaas_generation_requests_total[10m])), 0.001)",
          "legendFormat": "拒答率"
        }
      ]
    },
    {
      "id": 6,
      "title": "安全拦截速率",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "aipaas-prom"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum by (type) (rate(aipaas_security_blocks_total[5m]))", "legendFormat": "{{type}}"},
        {"refId": "B", "expr": "sum by (type, result) (rate(aipaas_security_checks_total[5m]))", "legendFormat": "{{type}}/{{result}}"}
      ]
    },
    {
      "id": 7,
      "title": "资源占用：JVM 堆 / 进程内存",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "datasource": {"type": "prometheus", "uid": "aipaas-prom"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [
        {"refId": "JVM", "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "JVM heap"},
        {"refId": "PY", "expr": "sum by (service) (aipaas_process_resident_memory_bytes)", "legendFormat": "{{service}} RSS"}
      ]
    },
    {
      "id": 8,
      "title": "资源占用：CPU",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "datasource": {"type": "prometheus", "uid": "aipaas-prom"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "targets": [
        {"refId": "JVM", "expr": "sum(rate(process_cpu_seconds_total{job=\"platform-gateway\"}[5m]))", "legendFormat": "platform-gateway"},
        {"refId": "PY", "expr": "sum by (service) (rate(aipaas_process_cpu_seconds_total[5m]))", "legendFormat": "{{service}}"}
      ]
    }
  ]
}
