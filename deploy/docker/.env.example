# =============================================================================
# AIPaaS 部署环境变量模板
# -----------------------------------------------------------------------------
# 使用：cp .env.example .env && vim .env
#
# 优先级（高 → 低）：
#   1. shell 已导出变量（如 source ../scripts/setup-env.sh devhome）
#   2. 本 .env 文件
#   3. docker-compose.yaml 中的内置默认值
#
# 部分变量 setup-env.sh 已导出（POSTGRES_*、REDIS_*、NACOS_*、MINIO_*、
# LLM_*、DOCKER_VOLUME_DIRECTORY、HOST_UID/HOST_GID 等），source 后会覆盖本文件。
# =============================================================================

# ---------- Docker 数据卷 & 日志目录 ----------
# 中间件数据目录（base 编排按 ${DOCKER_VOLUME_DIRECTORY}/volumes 拼接），默认值参考 setup-env.sh
DOCKER_VOLUME_DIRECTORY=/home/aipaas/docker_hub
# 应用日志目录（svc-ingest / svc-query 日志统一归档到 ./logs/<service>/）
DOCKER_LOG_DIRECTORY=.
# 容器进程 uid/gid（setup-env.sh 会自动导出为当前用户，此处为兜底默认值）
HOST_UID=1000
HOST_GID=1000

# ---------- 可选技术组件开关（Compose profiles）----------
# 核心组件（etcd/minio/milvus/mongodb）与应用服务始终启动；
# 以下可选组件按 profile 加载，逗号分隔，可任意组合：
#   attu      —— Milvus 可视化管理 UI（:3000）
#   nacos     —— postgres + nacos 配置中心（:8848）
#   redis     —— 缓存（:6379）
#   rocketmq  —— namesrv + broker 消息队列（:9876/:10911）
#   vllm      —— vLLM 本地推理 Qwen3-0.6B（:8008，需 NVIDIA GPU）
# 默认留空 = 全部不启动；示例：COMPOSE_PROFILES=nacos,redis
COMPOSE_PROFILES=

# ---------- 日志级别 ----------
LOG_LEVEL=INFO

# =============================================================================
# 中间件（默认值参考 setup-env.sh）
# =============================================================================

# --- MinIO 对象存储（与 setup-env.sh 命名一致）---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=aipaas

# --- MongoDB 文档存储（docker-compose-base.yaml 中账密固定为 admin/123456）---
MONGO_URL=mongodb://admin:123456@mongodb:27017/?authSource=admin
MONGO_DB_NAME=aipaas
MONGO_PORT=27017

# --- PostgreSQL（Nacos 主库，与 setup-env.sh 一致）---
POSTGRES_USER=nacos
POSTGRES_PASSWORD=nacos
POSTGRES_DB=nacos
POSTGRES_PORT=5432

# --- Redis 缓存（setup-env.sh 默认无密码）---
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Milvus 向量数据库（本地 compose 用服务名；连远程中间件时改为 http://<IP>:19530）---
MILVUS_URL=http://milvus:19530

# --- Milvus Collection（按需调整）---
CHUNKS_COLLECTION=chunks

# --- Nacos 配置中心（与 setup-env.sh 一致）---
NACOS_PORT=8848
NACOS_PORT_GRPC=9848
NACOS_AUTH_ENABLE=true
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=mySecureValue123
# 生产务必替换为 32 位以上随机字符串
NACOS_AUTH_TOKEN=VGhpc0lzTXlTZWNyZXRLZXlXaGljaFNob3VsZEJlMzJDaGFyYWN0ZXJzTGFyZ2U=

# --- RocketMQ 消息队列 ---
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_PORT2=10909
ROCKETMQ_NAMESRV_JAVA_OPT=-Xms128m -Xmx256m -Xmn64m
ROCKETMQ_BROKER_JAVA_OPT=-Xms256m -Xmx512m -Xmn128m

# =============================================================================
# Python AI 服务
# =============================================================================
# 说明：setup-env.sh 导出的是 LLM_BASE_URL / LLM_API_KEY / LLM_MODEL_NAME，
# 代码实际读取 OPENAI_BASE_URL / OPENAI_API_KEY / MODEL（compose 中已做映射）。

# --- svc-ingest（文档导入）---
INGEST_PORT=8000

# --- svc-query（用户查询）---
QUERY_PORT=8001

# --- 模型推理服务（嵌入 / 重排序）---
EMBEDDING_PORT=8101
RERANKER_PORT=8102
# 宿主机模型根目录（其下需有 bge-m3 / bge-reranker-large 两个目录）
MODEL_BASE_DIR=../../models
# 后端开关：offline=本地模型，online=DashScope 在线接口
EMBEDDING_BACKEND=offline
RERANKER_BACKEND=offline
# 离线模型设备与精度
BGE_DEVICE=cpu
BGE_FP16=False
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0
# 并发与批次上限
MODEL_EMBEDDING_MAX_BATCH=64
MODEL_EMBEDDING_MAX_CONCURRENCY=1
MODEL_RERANKER_MAX_DOCS=128
MODEL_RERANKER_MAX_CONCURRENCY=1
# 在线嵌入（EMBEDDING_BACKEND=online 时生效）
EMBEDDING_ONLINE_API_KEY=
EMBEDDING_ONLINE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_ONLINE_MODEL=text-embedding-v4
EMBEDDING_ONLINE_DIM=1536
# 在线重排序（RERANKER_BACKEND=online 时生效）
TEXT_RERANK_MODEL=qwen3-rerank
TEXT_RERANK_INSTRUCT=针对给定的查询，检索能够解答该查询的相关段落
# 业务侧 LLM / 在线模型密钥（在线后端未单独配置时复用）
OPENAI_API_KEY=

# --- 外部 LLM（容器内访问宿主机模型服务用 host.docker.internal）---
# 本地 compose 默认走容器内解析；连远程模型时改为 http://<IP>:11434/v1
# 启用 vLLM（COMPOSE_PROFILES 含 vllm）时改为：LLM_BASE_URL=http://vllm:8000/v1 LLM_API_KEY=EMPTY LLM_MODEL_NAME=qwen3-0.6b
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_NAME=qwen2.5

# --- vLLM 本地推理（COMPOSE_PROFILES 含 vllm 时生效，需 NVIDIA GPU）---
# 模型目录（ModelScope 下载 Qwen/Qwen3-0.6B 到该路径）
VLLM_MODEL_DIR=../../models/Qwen3-0.6B
VLLM_PORT=8008
VLLM_SERVED_MODEL_NAME=qwen3-0.6b
VLLM_MAX_MODEL_LEN=8192
# 显存占用比例（0~1，多模型同卡时调低）
VLLM_GPU_MEMORY_UTILIZATION=0.85

# =============================================================================
# Java 微服务（javaplat 暂为规划状态，未纳入编排；端口预留，详见 javaplat/TODO说明.md）
# =============================================================================
#GATEWAY_PORT=8085
#AUTH_PORT=8081
#DOCUMENT_PORT=9082
#SEARCH_PORT=8083
#AGENT_PORT=8086

# =============================================================================
# 前端
# =============================================================================
FRONTEND_PORT=80
