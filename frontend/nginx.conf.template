# ===========================================================================
# AIPaaS 前端 nginx 配置（SPA + API 反代）
# ---------------------------------------------------------------------------
# 这是一份 template，容器启动时由 envsubst 把
# ${QUERY_API_UPSTREAM} / ${IMPORT_API_UPSTREAM} 替换成运行时环境变量的值。
# 其他 nginx 内置变量（$uri, $args, $http_* 等）不会被碰。
# ===========================================================================

server {
    listen       80;
    server_name  _;

    # SPA 单页应用路由：任何未命中的路径都返回 index.html，
    # 让前端 react-router 在浏览器端处理
    location / {
        root   /usr/share/nginx/html;
        index  index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # /query-api 反代到后端查询服务
    # （对应 vite.config.js 里 dev proxy 的 /query-api → 8001）
    location /query-api/ {
        proxy_pass         ${QUERY_API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # /import-api 反代到后端导入服务
    # （对应 vite.config.js 里 dev proxy 的 /import-api → 8000）
    location /import-api/ {
        proxy_pass         ${IMPORT_API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # 健康检查端点
    location = /health {
        access_log off;
        return 200 "ok\n";
    }
}
